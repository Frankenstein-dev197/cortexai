SERVER_PORT=3001
JWT_SECRET="my-random-string-for-seeding" # Generate a strong random secret in production.
# JWT_EXPIRY="30d"
SIG_KEY='passphrase' # Generate a strong random value of at least 32 chars.
SIG_SALT='salt' # Generate a strong random value of at least 32 chars.

###########################################
######## CORTEX AUTH / OAUTH ##############
###########################################
# Required for Google/GitHub OAuth in multi-user mode.
# Use the exact callback URLs registered with each provider.
CORTEX_PUBLIC_URL="https://your-cortex-domain.example"
CORTEX_FRONTEND_URL="https://your-cortex-domain.example"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional overrides when the API is hosted separately from the frontend.
# GOOGLE_OAUTH_REDIRECT_URI="https://api.example.com/api/auth/google/callback"
# GITHUB_OAUTH_REDIRECT_URI="https://api.example.com/api/auth/github/callback"

###########################################
######## STRIPE BILLING ###################
###########################################
# Keep Stripe credentials server-side only. Prefer a restricted key for production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
# STRIPE_API_VERSION="2026-06-24.dahlia"

