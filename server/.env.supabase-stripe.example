# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# Legacy projects may use SUPABASE_ANON_KEY instead.

# Public Cortex URL used for Stripe redirects
CORTEX_PUBLIC_URL=https://your-cortex-domain.example

# Stripe server-only secrets. Never expose these to Vite/frontend code.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# Stripe Price ID for the subscription plan
STRIPE_DEFAULT_PRICE_ID=price_xxxxxxxxxxxxxxxxx
