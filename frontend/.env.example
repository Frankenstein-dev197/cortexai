VITE_API_BASE='http://localhost:3001/api' # Use this URL when developing locally
# VITE_API_BASE="https://$CODESPACE_NAME-3001.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN/api" # for GitHub Codespaces
# VITE_API_BASE='/api' # Use this URL when deploying on a non-localhost address or in Docker.

# Supabase Auth — use the project URL and publishable key from Supabase.
VITE_SUPABASE_URL='https://YOUR_PROJECT_REF.supabase.co'
VITE_SUPABASE_PUBLISHABLE_KEY='sb_publishable_...'

# Supabase Dashboard → Authentication → URL Configuration
# Add your production frontend URL to Site URL / Redirect URLs.
# OAuth callback is handled by Supabase; do not put provider client secrets here.
